# InvoiceFlow — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env or .env.local with real secrets.

# ── Database (Supabase PostgreSQL) ──
DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# ── Authentication ──
NEXTAUTH_SECRET="generate-a-random-32-char-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Google OAuth (optional — leave blank to disable Google Sign-In) ──
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_PROJECT_REF=""
SUPABASE_DATABASE_URL=""
